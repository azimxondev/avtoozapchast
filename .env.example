# =====================================================
# AVTO SKLAD — SOZLAMALAR SHABLONI (.env.example)
# Bu shablon fayli GitHub'ga xavfsiz yuklanadi
# =====================================================

# 1. Telegram Bot Token (BotFather bergan tokeningiz)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Admin Telegram ID raqamlari (vergul bilan ajratilgan)
# Birinchi ID = Bosh Admin (Head Admin)
ADMIN_IDS=123456789,987654321

# 3. PostgreSQL Ma'lumotlar Bazasi (Neon Cloud havolasi)
DATABASE_URL=postgresql://username:password@hostname/database?sslmode=require

# 4. Web App manzili (Render domeni)
WEBAPP_URL=https://your-app-name.onrender.com

# 5. Do'kon manzili (Matnli manzil)
SHOP_ADDRESS=Toshkent sh., Uchtepa tumani, Farhod avto ehtiyot qismlar bozori

# 6. Do'kon koordinatalari (ixtiyoriy — aniqroq xarita uchun)
# SHOP_LAT=41.311081
# SHOP_LON=69.279737
