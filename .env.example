# =====================================================
# AUTO SKLAD — CONFIGURATION TEMPLATE (.env.example)
# Safe for GitHub. Contains NO real credentials.
# Copy to .env and fill in real values.
# =====================================================

# Environment mode: development, production, test
ENVIRONMENT=production

# Standalone browser demo mode (MUST be false in production!)
DEMO_MODE=false

# Telegram Head Admin (Single Master Admin ID)
HEAD_ADMIN_ID=YOUR_HEAD_ADMIN_ID

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN

# Application Secret Key (Generate a random 32+ char key)
SECRET_KEY=YOUR_SECRET_KEY

# PostgreSQL Database URL (Neon Cloud, Supabase, or AWS RDS)
DATABASE_URL=YOUR_DATABASE_URL

# WebApp URL (Public HTTPS domain for Telegram WebApp)
WEBAPP_URL=https://your-domain.onrender.com

# Initial budget default (UZS)
INITIAL_BUDGET=150000000

# Shop Information
SHOP_NAME="Auto Sklad & Ehtiyot Qismlar"
SHOP_PHONE="+998 ** *** ** **"
SHOP_TELEGRAM="@your_telegram_contact"
SHOP_ADDRESS="Toshkent sh., Sergeli mashina bozori"
SHOP_WORK_HOURS="Dushanba - Shanba: 08:30 - 18:30"
