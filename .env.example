# ==============================================================================
# kuzavnoy.uzz — NAMUNAVIY SOZLAMALAR SHABLONI (.env.example)
# Bu shablon fayli GitHub'ga xavfsiz yuklanadi (ichida haqiqiy parollar bo'lmaydi)
# ==============================================================================

# 1. Server sozlamalari
PORT=3000
NODE_ENV=development

# 2. Telegram Bot Token (BotFather bergan tokeningizni kiriting)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 3. PostgreSQL Ma'lumotlar Bazasi (Neon Cloud yoki boshqa PostgreSQL havolasi)
DATABASE_URL=postgresql://username:password@hostname/database?sslmode=require

# 4. Admin Telegram ID raqami (masalan: 123456789)
ADMIN_CHAT_IDS=YOUR_TELEGRAM_ID
ADMIN_IDS=YOUR_TELEGRAM_ID

# 5. Veb Ilova manzili (Render domeni yoki localhost)
WEB_APP_URL=https://your-app-name.onrender.com

# 6. Admin Panel maxfiy PIN kodi
ADMIN_SECRET_PIN=7777
